rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Bloqueio padrão para todas as outras coleções
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidInsumo(data) {
      return data.keys().hasAll(['nome', 'fornecedor', 'quantidade', 'unidade', 'preco', 'custoUnitario']) &&
        data.nome is string && data.nome.size() >= 1 && data.nome.size() <= 100 &&
        data.fornecedor is string && data.fornecedor.size() >= 1 && data.fornecedor.size() <= 100 &&
        (!data.keys().hasAny(['fornecedorId']) ||
          data.fornecedorId == null || (data.fornecedorId is string && data.fornecedorId.size() <= 128)) &&
        (!data.keys().hasAny(['grupoComparacao']) ||
          (data.grupoComparacao is string && data.grupoComparacao.size() >= 1 && data.grupoComparacao.size() <= 100)) &&
        (!data.keys().hasAny(['marca']) ||
          (data.marca is string && data.marca.size() <= 100)) &&
        data.quantidade is number && data.quantidade > 0 &&
        data.unidade is string && data.unidade in ['kg', 'g', 'L', 'ml', 'un'] &&
        data.preco is number && data.preco >= 0 &&
        data.custoUnitario is number && data.custoUnitario >= 0 &&
        (!data.keys().hasAny(['estoqueAtual']) ||
          (data.estoqueAtual is number && data.estoqueAtual >= 0)) &&
        (!data.keys().hasAny(['estoqueMinimo']) ||
          (data.estoqueMinimo is number && data.estoqueMinimo >= 0));
    }

    function isValidFornecedor(data) {
      return data.keys().hasAll(['nome']) &&
        data.nome is string && data.nome.size() >= 1 && data.nome.size() <= 100 &&
        (!data.keys().hasAny(['telefone']) || (data.telefone is string && data.telefone.size() <= 40)) &&
        (!data.keys().hasAny(['email']) || (data.email is string && data.email.size() <= 120)) &&
        (!data.keys().hasAny(['observacoes']) || (data.observacoes is string && data.observacoes.size() <= 300));
    }

    function isValidReceita(data) {
      return data.keys().hasAll(['nome', 'rendimento', 'rendimentoUnidade', 'itens', 'custoTotal', 'custoUnitario']) &&
        data.nome is string && data.nome.size() >= 1 && data.nome.size() <= 100 &&
        data.rendimento is number && data.rendimento > 0 &&
        data.rendimentoUnidade is string && data.rendimentoUnidade.size() <= 50 &&
        data.itens is list && data.itens.size() <= 100 &&
        data.custoTotal is number && data.custoTotal >= 0 &&
        data.custoUnitario is number && data.custoUnitario >= 0;
    }

    function isValidProducao(data) {
      return data.keys().hasAll([
          'receitaId', 'receitaNome', 'quantidade', 'data', 'quantidadeProduzida',
          'unidadeProduzida', 'custoInsumos', 'custoIndireto', 'custoReal',
          'custoUnitarioReal', 'insumos', 'createdBy'
        ]) &&
        data.receitaId is string && data.receitaId.size() > 0 &&
        data.receitaNome is string && data.receitaNome.size() >= 1 && data.receitaNome.size() <= 100 &&
        data.quantidade is number && data.quantidade >= 1 && data.quantidade % 1 == 0 &&
        data.data is string && data.data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.quantidadeProduzida is number && data.quantidadeProduzida > 0 &&
        data.unidadeProduzida is string && data.unidadeProduzida.size() <= 50 &&
        data.custoInsumos is number && data.custoInsumos >= 0 &&
        data.custoIndireto is number && data.custoIndireto >= 0 &&
        data.custoReal is number && data.custoReal >= 0 &&
        data.custoUnitarioReal is number && data.custoUnitarioReal >= 0 &&
        data.insumos is list && data.insumos.size() > 0 && data.insumos.size() <= 100 &&
        data.createdBy is string && data.createdBy.size() > 0 && data.createdBy.size() <= 128 &&
        (!data.keys().hasAny(['precoVendaUnitario']) ||
          (data.precoVendaUnitario is number && data.precoVendaUnitario >= 0));
    }

    // Coleção de insumos para os 2 padeiros da padaria artesanal
    match /insumos/{insumoId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(insumoId) && isValidInsumo(incoming());
      allow update: if isSignedIn() && isValidId(insumoId) && isValidInsumo(incoming());
      allow delete: if isSignedIn() && isValidId(insumoId);
    }

    match /fornecedores/{fornecedorId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(fornecedorId) && isValidFornecedor(incoming());
      allow update: if isSignedIn() && isValidId(fornecedorId) && isValidFornecedor(incoming());
      allow delete: if isSignedIn() && isValidId(fornecedorId);
    }

    // Coleção de receitas de pães e produtos da padaria
    match /receitas/{receitaId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(receitaId) && isValidReceita(incoming());
      allow update: if isSignedIn() && isValidId(receitaId) && isValidReceita(incoming());
      allow delete: if isSignedIn() && isValidId(receitaId);
    }

    match /producoes/{producaoId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(producaoId) && isValidProducao(incoming());
      allow update: if isSignedIn() && isValidId(producaoId) &&
        isValidProducao(incoming()) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'data', 'quantidadeProduzida', 'precoVendaUnitario', 'custoUnitarioReal', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(producaoId);
    }
  }
}
