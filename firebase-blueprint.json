{
  "entities": {
    "insumo": {
      "title": "Insumo",
      "description": "Matéria-prima com custo unitário, quantidade atual e estoque mínimo para alertas e baixa automática na produção",
      "type": "object",
      "properties": {
        "nome": {
          "type": "string",
          "description": "Nome do insumo ou ingrediente",
          "minLength": 1,
          "maxLength": 100
        },
        "fornecedor": {
          "type": "string",
          "description": "Nome do fornecedor ou mercado",
          "minLength": 1,
          "maxLength": 100
        },
        "quantidade": {
          "type": "number",
          "description": "Quantidade da embalagem"
        },
        "estoqueAtual": {
          "type": "number",
          "minimum": 0,
          "description": "Quantidade disponível no estoque, na unidade cadastrada"
        },
        "estoqueMinimo": {
          "type": "number",
          "minimum": 0,
          "description": "Nível mínimo que dispara o alerta de reposição"
        },
        "unidade": {
          "type": "string",
          "enum": ["kg", "g", "L", "ml", "un"],
          "description": "Unidade de medida da embalagem"
        },
        "preco": {
          "type": "number",
          "description": "Preço pago pela embalagem em Reais"
        },
        "custoUnitario": {
          "type": "number",
          "description": "Custo calculado por unidade base"
        },
        "categoria": {
          "type": "string",
          "enum": ["ingrediente", "embalagem", "outro"],
          "description": "Grupo ou categoria do insumo (Ingrediente, Embalagem descartável, Outro)"
        },
        "conversoes": {
          "type": "object",
          "description": "Fatores específicos do ingrediente convertidos para gramas ou mililitros",
          "properties": {
            "baseUnit": { "type": "string", "enum": ["g", "ml"] },
            "xicara": { "type": "number" },
            "colher_sopa": { "type": "number" },
            "colher_cha": { "type": "number" },
            "un": { "type": "number" }
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdBy": {
          "type": "string",
          "description": "UID do padeiro que cadastrou"
        },
        "createdByName": {
          "type": "string",
          "description": "Nome do padeiro"
        }
      },
      "required": [
        "nome",
        "fornecedor",
        "quantidade",
        "unidade",
        "preco",
        "custoUnitario"
      ]
    },
    "receita": {
      "title": "Receita",
      "description": "Receita de panificação caseira com ingredientes, embalagens e cálculo de custos e lucro",
      "type": "object",
      "properties": {
        "nome": {
          "type": "string",
          "description": "Nome da receita de pão ou produto",
          "minLength": 1,
          "maxLength": 100
        },
        "categoria": {
          "type": "string",
          "enum": ["paes", "bolos", "salgados", "outros"],
          "description": "Categoria usada para filtrar receitas"
        },
        "descricao": {
          "type": "string",
          "description": "Observações ou modo de preparo rápido"
        },
        "modoPreparo": {
          "type": "string",
          "description": "Etapas detalhadas de preparo"
        },
        "tempoPreparoMin": { "type": ["number", "null"] },
        "tempoFornoMin": { "type": ["number", "null"] },
        "temperaturaFornoC": { "type": ["number", "null"] },
        "fotoDataUrl": {
          "type": ["string", "null"],
          "description": "Foto JPEG redimensionada e comprimida da receita"
        },
        "rendimento": {
          "type": "number",
          "description": "Quantidade de unidades ou porções produzidas"
        },
        "rendimentoUnidade": {
          "type": "string",
          "description": "Nome da unidade de rendimento (ex: pães, unidades, fatias)"
        },
        "itens": {
          "type": "array",
          "description": "Lista de ingredientes, embalagens e receitas-base utilizados na receita",
          "items": {
            "type": "object",
            "properties": {
              "sourceType": { "type": "string", "enum": ["insumo", "receita"] },
              "insumoId": { "type": ["string", "null"] },
              "receitaId": { "type": "string" },
              "insumoNome": { "type": "string" },
              "quantidadeUsada": { "type": "number" },
              "unidadeUsada": { "type": "string" },
              "custoUnitarioBase": { "type": "number" },
              "unidadeBase": { "type": "string" },
              "custoItem": { "type": "number" },
              "conversoes": { "type": "object" }
            }
          }
        },
        "custoIngredientes": {
          "type": "number",
          "description": "Custo total dos ingredientes em Reais"
        },
        "custoEmbalagens": {
          "type": "number",
          "description": "Custo total de sacolas e formas descartáveis em Reais"
        },
        "custoTotal": {
          "type": "number",
          "description": "Custo total da receita (ingredientes + embalagens)"
        },
        "custoUnitario": {
          "type": "number",
          "description": "Custo de produção por unidade produzida"
        },
        "custoEnergia": {
          "type": "number",
          "description": "Custo de gás ou energia por fornada"
        },
        "custoMaoDeObra": {
          "type": "number",
          "description": "Custo de mão de obra pelo tempo de preparo ativo"
        },
        "valorHoraMaoDeObra": {
          "type": "number",
          "description": "Valor da hora usado no cálculo da receita"
        },
        "custoAgua": {
          "type": "number",
          "description": "Custo de água por fornada"
        },
        "custoIndireto": {
          "type": "number",
          "description": "Soma de energia, mão de obra e água por fornada"
        },
        "unidadesPerdidas": {
          "type": "number",
          "description": "Unidades descartadas por perda ou quebra"
        },
        "unidadesVendaveis": {
          "type": "number",
          "description": "Rendimento da fornada menos unidades perdidas"
        },
        "margemLucroDesejada": {
          "type": "number",
          "description": "Margem de lucro desejada em porcentagem (ex: 100%)"
        },
        "precoVendaSugerido": {
          "type": "number",
          "description": "Preço de venda sugerido por unidade em Reais"
        },
        "precoVendaPraticado": {
          "type": "number",
          "description": "Preço de venda efetivamente praticado pelo padeiro"
        },
        "lucroPorUnidade": {
          "type": "number",
          "description": "Lucro líquido unitário em Reais"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdBy": {
          "type": "string"
        },
        "createdByName": {
          "type": "string"
        }
      },
      "required": [
        "nome",
        "rendimento",
        "rendimentoUnidade",
        "itens",
        "custoTotal",
        "custoUnitario"
      ]
    },
    "producao": {
      "title": "Produção",
      "description": "Registro imutável de uma ou mais fornadas com baixa de estoque e custo real calculado no momento da produção",
      "type": "object",
      "properties": {
        "receitaId": { "type": "string" },
        "receitaNome": { "type": "string" },
        "quantidade": {
          "type": "number",
          "description": "Quantidade de fornadas registradas"
        },
        "data": {
          "type": "string",
          "format": "date",
          "description": "Data em que a produção ocorreu"
        },
        "quantidadeProduzida": { "type": "number" },
        "unidadeProduzida": { "type": "string" },
        "precoVendaUnitario": {
          "type": "number",
          "description": "Preço de venda praticado por unidade na data da produção"
        },
        "custoInsumos": { "type": "number" },
        "custoIndireto": { "type": "number" },
        "custoReal": { "type": "number" },
        "custoUnitarioReal": { "type": "number" },
        "insumos": {
          "type": "array",
          "description": "Snapshot dos insumos consumidos e seus custos unitários no momento da produção",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "nome": { "type": "string" },
              "quantidade": { "type": "number" },
              "unidade": { "type": "string" },
              "custoUnitario": { "type": "number" },
              "custo": { "type": "number" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "createdByName": { "type": "string" }
      },
      "required": [
        "receitaId",
        "receitaNome",
        "quantidade",
        "data",
        "quantidadeProduzida",
        "unidadeProduzida",
        "custoInsumos",
        "custoIndireto",
        "custoReal",
        "custoUnitarioReal",
        "insumos",
        "createdBy"
      ]
    }
  },
  "firestore": {
    "/insumos/{insumoId}": {
      "schema": "insumo",
      "description": "Coleção de insumos da padaria artesanal compartilhada entre padeiros autenticados"
    },
    "/receitas/{receitaId}": {
      "schema": "receita",
      "description": "Coleção de receitas de pães com cálculo automático de custos e precificação"
    },
    "/producoes/{producaoId}": {
      "schema": "producao",
      "description": "Histórico de fornadas com custos reais e baixa de estoque"
    }
  }
}
